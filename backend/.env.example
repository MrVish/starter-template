# General Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-for-production
API_VERSION=v1

# Database Settings
DB_TYPE=sqlite  # mysql or sqlite
# MySQL Settings (if using MySQL)
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=modular_framework

# JWT Settings
JWT_SECRET_KEY=your-jwt-secret-key

# OAuth Settings
# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Azure AD (for SSO)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# Cloud Storage Settings
CLOUD_PROVIDER=local  # local, aws, or gcp

# AWS Settings (if using AWS)
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# GCP Settings (if using GCP)
GCP_PROJECT_ID=
GCP_BUCKET=

# Celery and Redis Settings
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email Settings
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@example.com

# Slack Settings
SLACK_API_TOKEN= 